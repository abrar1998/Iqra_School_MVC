
@{
    ViewData["Title"] = "AdminDashBoard";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="dashboard">
   
    <h3>Welcome to the Iqra Educational Institute Admin Dashboard</h3>
    <div class="stats-overview mt-5">
        <div class="stat-card">
            <i class="fas fa-bell"></i>
            <h3>Total Notices</h3>
            <p>120</p>
        </div>
        <div class="stat-card">
            <i class="fas fa-calendar-check"></i>
            <h3>Total Events</h3>
            <p>45</p>
        </div>
        <div class="stat-card">
            <i class="fas fa-file-alt"></i>
            <h3>Pages</h3>
            <p>10</p>
        </div>
        <div class="stat-card">
            <i class="fas fa-bullhorn"></i>
            <h3>Notifications</h3>
            <p>5</p>
        </div>
      
    </div>
</div>




