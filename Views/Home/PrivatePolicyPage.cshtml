
@{
    ViewData["Title"] = "PrivatePolicyPage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="privacy-policy-container">
        <h2 class="privacy-title">Privacy Policy</h2>
        <p class="privacy-intro">
            Your privacy is very important to us. Accordingly, we have developed this policy to help you understand how we collect, use, communicate, and protect your personal information.
        </p>

        <div class="privacy-content">
            <ul class="privacy-list">
                <li><strong>Information Collection:</strong> Before or at the time of collecting personal information, we will identify the purposes for which it is being collected.</li>
                <li><strong>Purpose Limitation:</strong> We will use personal information solely to fulfill those specified purposes unless consent is obtained or required by law.</li>
                <li><strong>Data Retention:</strong> Personal information will be retained only as long as necessary for its intended purposes.</li>
                <li><strong>Lawful Collection:</strong> We will collect information fairly and lawfully, with the knowledge or consent of the individual concerned.</li>
                <li><strong>Data Accuracy:</strong> Personal data should be relevant, accurate, complete, and up-to-date for its intended purposes.</li>
                <li><strong>Security Measures:</strong> Personal information will be protected against unauthorized access, loss, theft, disclosure, copying, use, or modification.</li>
                <li><strong>Transparency:</strong> We will provide information regarding our policies and practices for managing personal data.</li>
            </ul>
        </div>
    </div>
</div>

<style>
    .privacy-policy-container {
        max-width: 800px;
        margin: 50px auto;
        background: #fff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .privacy-title {
        font-size: 28px;
        font-weight: bold;
        color: var(--primary-color);
        text-align: center;
        margin-bottom: 15px;
    }

    .privacy-intro {
        font-size: 16px;
        text-align: center;
        margin-bottom: 20px;
        color: #555;
    }

    .privacy-content {
        font-size: 16px;
        line-height: 1.6;
        color: #333;
    }

    .privacy-list {
        list-style: none;
        padding: 0;
    }

        .privacy-list li {
            padding: 10px;
            border-left: 5px solid var(--primary-color);
            background: #f9f9f9;
            margin-bottom: 10px;
            border-radius: 5px;
        }

            .privacy-list li strong {
                color: var(--primary-color);
            }
</style>


